<?xml version="1.0" encoding="utf-8"?>
<!--
  WinDevCleaner installer (plan, sections 4.3 and 6.5). WiX Toolset v5.

  Per-user: installs to %LOCALAPPDATA%\Programs\WinDevCleaner without admin rights, adds that
  folder to the user's PATH (so `wdc` works in any new terminal) and a Start menu shortcut
  for the app. Uninstall removes all three. The tool's data folder
  (%LOCALAPPDATA%\WinDevCleaner: snapshots and the activity log) is left alone.

  Build: wix build installer\WinDevCleaner.wxs -arch x64 -d Version=<major.minor.patch> -d BinDir=target\release -o WinDevCleaner.msi
  An MSI version is numbers only: for 1.0.0-rc.1 pass the numeric core, 1.0.0. AllowSameVersionUpgrades
  lets the final 1.0.0 replace the rc, which has the same MSI version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="WinDevCleaner"
      Manufacturer="Paulo Raoni"
      Version="$(Version)"
      UpgradeCode="6F1B6A9E-5C1D-4E1B-9C59-2A8C3A7E0D41"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of WinDevCleaner is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="WinDevCleaner" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="WinDevCleaner" Level="1">
      <Component Id="Cli" Directory="INSTALLFOLDER" Guid="9B0F4C36-3E2B-4E6A-8F0E-0C4B9A1D2E01">
        <File Id="WdcExe" Source="$(BinDir)\wdc.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\WinDevCleaner" Name="cli" Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="App" Directory="INSTALLFOLDER" Guid="9B0F4C36-3E2B-4E6A-8F0E-0C4B9A1D2E02">
        <File Id="AppExe" Source="$(BinDir)\WinDevCleaner.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\WinDevCleaner" Name="app" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="9B0F4C36-3E2B-4E6A-8F0E-0C4B9A1D2E03">
        <Shortcut Id="AppShortcut" Name="WinDevCleaner" Description="Find where your disk space is"
                  Target="[INSTALLFOLDER]WinDevCleaner.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\WinDevCleaner" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
